system:
  http_port: 8080
  run_mode: debug
  worker_id: 0
  param_secret: ceqcyxnprtj1tzch

log:
  path: ./example.log
  level: debug

db:
  - driver_name: mysql
    host: 127.0.0.1
    port: 3306
    user: root
    password: 123456
    database: ys_gin_example
    charset: utf8
    # loc：DATETIME 读写时区（DSN loc 参数），缺省 Local（兼容旧行为）；写原值如 UTC、Asia/Shanghai（勿预先转义）
    loc: Asia/Shanghai
    max_open: 20
    max_idle: 10
